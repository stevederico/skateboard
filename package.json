{
  "name": "skateboard",
  "private": false,
  "version": "4.26.0",
  "skateboardVersion": "4.26.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite --mode development",
    "front": "vite --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "prod": "npm run typecheck && vite build --mode production",
    "install-all": "npm install",
    "postinstall": "git config core.hooksPath .githooks || true",
    "verify:ui": "node scripts/verify-ui-version.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run test:build",
    "test:build": "node --experimental-test-module-mocks --test vite.plugins.test.js scripts/verify-ui-version.test.js scripts/update-skateboard.test.js scripts/version-consistency.test.js"
  },
  "dependencies": {
    "@stevederico/skateboard-ui": "4.15.0",
    "lucide-react": "0.546.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "typescript": "7.0.2",
    "vite": "8.0.13"
  }
}
