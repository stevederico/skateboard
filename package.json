{
  "name": "skateboard",
  "private": false,
  "version": "5.26.0",
  "skateboardVersion": "5.26.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite --mode development",
    "front": "vite --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "prod": "npm run typecheck && vite build --mode production",
    "install-all": "npm install",
    "postinstall": "git config core.hooksPath >/dev/null 2>&1 || git config core.hooksPath .githooks || true",
    "verify:ui": "node scripts/verify-ui-version.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run test:build && npm run test:docs",
    "test:build": "node --experimental-test-module-mocks --test vite.plugins.test.js scripts/verify-ui-version.test.js scripts/update-skateboard.test.js scripts/version-consistency.test.js",
    "test:docs": "node scripts/test-docs.mjs",
    "guardrails:install": "npm ci --prefix guardrails --no-audit --no-fund",
    "lint": "oxlint",
    "test:guardrails": "node --test \"guardrails/eslint-plugin/**/*.test.js\"",
    "depcruise": "node guardrails/node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config .dependency-cruiser.js .",
    "verify": "node --test --test-reporter=spec guardrails/verify/verify.e2e.js"
  },
  "dependencies": {
    "@stevederico/skateboard-ui": "5.26.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
