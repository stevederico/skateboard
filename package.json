{
  "name": "skateboard",
  "private": false,
  "version": "4.20.1",
  "skateboardVersion": "4.20.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite --force --mode development",
    "front": "vite --force --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "prod": "npm run typecheck && vite build --mode production",
    "install-all": "npm install",
    "postinstall": "git config core.hooksPath .githooks || true",
    "verify:ui": "node scripts/verify-ui-version.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run test:frontend && npm run test:build",
    "test:frontend": "vitest run",
    "test:build": "node --experimental-test-module-mocks --test vite.plugins.test.js scripts/verify-ui-version.test.js scripts/update-skateboard.test.js scripts/version-consistency.test.js",
    "test:coverage": "npm run test:coverage:build",
    "test:coverage:build": "node --experimental-test-module-mocks --experimental-test-coverage --test vite.plugins.test.js scripts/verify-ui-version.test.js"
  },
  "dependencies": {
    "@stevederico/skateboard-ui": "4.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.3.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.0",
    "typescript": "7.0.2",
    "vite": "8.0.13",
    "vitest": "^3.2.4"
  }
}
