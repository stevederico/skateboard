# Skateboard Backend Environment Configuration
# Copy to .env and replace with actual values

# Database is SQLite (backend/config.json). Postgres/Mongo are not supported.

# Stripe payments
STRIPE_KEY=sk_test_your_stripe_secret_key_here
STRIPE_ENDPOINT_SECRET=whsec_your_webhook_endpoint_secret_here

# JWT authentication
JWT_SECRET=your_super_secure_jwt_secret_here_make_it_long_and_random

# Usage limits
FREE_USAGE_LIMIT=20

# Runtime — NODE_ENV=production enables HSTS, skips .env loading, and requires JWT_SECRET
NODE_ENV=development
PORT=8000

# Number of trusted reverse proxies in front of this process. Set it only when
# every one of those hops is trusted (1 for a single proxy such as Railway).
# Signup/signin rate limits and lockouts then key off the Nth-from-last
# X-Forwarded-For hop instead of the socket peer. Leave unset when the process
# is exposed directly — proxies append to X-Forwarded-For, so the leftmost
# entry is client-supplied and trusting it lets an attacker mint a fresh
# rate-limit bucket per request.
# TRUST_PROXY=1

# Production CORS and redirects
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# FRONTEND_URL=https://yourdomain.com
